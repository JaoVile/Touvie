# Supabase (pegue em https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service role (NUNCA exponha no client — só usar em server actions/routes)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Secret para assinar o cookie de dispositivo confiável
# Gere com: openssl rand -base64 32
TRUSTED_DEVICE_SECRET=

# Freesound — chave da API pra baixar os loops do som de fundo (CC0/CC-BY).
# Crie grátis em https://freesound.org/apiv2/apply/ e rode: npm run fetch:sounds
FREESOUND_API_KEY=

# Telegram bot — token do @BotFather
TELEGRAM_BOT_TOKEN=

# Secret enviado pra Telegram em setWebhook; volta no header
# X-Telegram-Bot-Api-Secret-Token. Gere com openssl rand -hex 32.
TELEGRAM_WEBHOOK_SECRET=

# Secret para proteger os crons (gere com openssl rand -base64 32)
# Vercel injeta automaticamente como Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# URL pública do app — usada pra montar o webhook do Telegram em
# app/(app)/notificacoes/actions.ts. Em produção use a URL da Vercel
# (ex: https://touvie.vercel.app). Em local pode deixar vazio.
NEXT_PUBLIC_APP_URL=
