# Supabase (pegue em https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service role (NUNCA exponha no client — só usar em server actions/routes)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Secret para assinar o cookie de dispositivo confiável
# Gere com: openssl rand -base64 32
TRUSTED_DEVICE_SECRET=

# Telegram bot — token do @BotFather
TELEGRAM_BOT_TOKEN=

# Secret enviado pra Telegram em setWebhook; volta no header
# X-Telegram-Bot-Api-Secret-Token. Gere com openssl rand -hex 32.
TELEGRAM_WEBHOOK_SECRET=

# Secret para proteger os crons (gere com openssl rand -base64 32)
# Vercel injeta automaticamente como Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
