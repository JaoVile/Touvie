{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "crons": [
    { "path": "/api/cron/training-reminder",              "schedule": "30 9 * * *"   },
    { "path": "/api/cron/daily-reminders",                "schedule": "0 10 * * *"   },
    { "path": "/api/cron/work-clock?type=clock-in-morning","schedule": "30 11 * * 1-5"},
    { "path": "/api/cron/work-clock?type=lunch-break",    "schedule": "0 15 * * 1-5" },
    { "path": "/api/cron/work-clock?type=clock-in-afternoon","schedule": "0 16 * * 1-5"},
    { "path": "/api/cron/work-clock?type=clock-out",      "schedule": "30 20 * * 1-5"},
    { "path": "/api/cron/evening-reminders",              "schedule": "0 23 * * *"   }
  ]
}
