# Credenciais do USUÁRIO DE TESTE dedicado (E2E). Copie para .env.test (NÃO
# commitado) e preencha. Este usuário é só pros testes — nunca sua conta real.
#
# Como criar o usuário: cadastre-se no app em /signup (email + senha + nome +
# palavra-chave). Use um email que você reconheça como de teste.

TEST_USER_EMAIL=teste@touvie.app
TEST_USER_PASSWORD=troque-por-uma-senha-forte

# Segundo usuário de teste — necessário só pros testes de RLS cross-user (provam
# que o usuário A não enxerga os dados do usuário B). Crie do mesmo jeito em
# /signup, com OUTRO email. Sem estas vars, os specs de RLS cross-user são pulados.
TEST_USER2_EMAIL=teste2@touvie.app
TEST_USER2_PASSWORD=troque-por-outra-senha-forte

# Opcional — base do app nos testes (default: http://localhost:3007)
# E2E_BASE_URL=http://localhost:3007
